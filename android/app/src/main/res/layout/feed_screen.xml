<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/feed_moment_background">
  <View android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="center" android:alpha="0.09" android:background="@drawable/camera_look_selected"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:id="@+id/feed_for_you" style="@style/FeedTab.Active" android:text="For You"/><TextView android:id="@+id/feed_following" style="@style/FeedTab" android:text="Following"/><TextView android:id="@+id/feed_nearby" style="@style/FeedTab" android:text="Nearby"/><TextView android:id="@+id/feed_live" style="@style/FeedTab" android:text="Live ●"/><TextView android:id="@+id/feed_camera" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="◉" android:textColor="@android:color/white" android:textSize="24sp" android:contentDescription="@string/camera_action"/>
      <TextView android:id="@+id/feed_search" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="⌕" android:textColor="@android:color/white" android:textSize="28sp" android:contentDescription="@string/search"/>
    </LinearLayout>
  </LinearLayout>

  <!-- Newly captured moment card: filled in by MainScreenFragment when the camera has just
       produced a photo, providing the explicit "camera is linked to the feed" surface. -->
  <LinearLayout android:id="@+id/feed_latest_moment" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginStart="16dp" android:layout_marginTop="72dp" android:layout_marginEnd="92dp" android:background="#E61B1724" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your moment is live on Feed" android:textColor="#99FFFFFF" android:textSize="11sp" android:letterSpacing="0.16"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
      <ImageView android:id="@+id/feed_latest_thumbnail" android:layout_width="46dp" android:layout_height="46dp" android:background="#4DFFFFFF" android:scaleType="centerCrop"/>
      <TextView android:id="@+id/feed_latest_caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:textColor="@android:color/white" android:textSize="14sp"/>
    </LinearLayout>
  </LinearLayout>

  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="MOMENT" android:textColor="#99FFFFFF" android:textSize="11sp" android:letterSpacing="0.22"/>
  <LinearLayout android:layout_width="68dp" android:layout_height="wrap_content" android:layout_gravity="right|center_vertical" android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/feed_follow" style="@style/FeedAction" android:text="+\nFollow"/><TextView android:id="@+id/feed_like" style="@style/FeedAction" android:text="♡\n2.8K"/><TextView android:id="@+id/feed_ripple" style="@style/FeedAction" android:text="≋\nRipple"/><TextView android:id="@+id/feed_comment" style="@style/FeedAction" android:text="◌\n184"/><TextView android:id="@+id/feed_save" style="@style/FeedAction" android:text="⌑\nSave"/><TextView android:id="@+id/feed_share" style="@style/FeedAction" android:text="↗\nShare"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="92dp" android:paddingBottom="18dp">
    <LinearLayout android:id="@+id/feed_profile" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/camera_capture_ring"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="alfred.m  ✓" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold"/><TextView android:id="@+id/feed_context" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="2h ago • Sandton" android:textColor="#CCFFFFFF" android:textSize="12sp"/></LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="3" android:text="The room changed when this track dropped. Johannesburg, you had to be there. 🔥" android:textColor="@android:color/white" android:textSize="15sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="👥 8 friends rippled this" android:textColor="#E6FFFFFF" android:textSize="13sp"/>
    <LinearLayout android:id="@+id/feed_invitation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/feed_invitation_background" android:orientation="vertical">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📍 Cocoon Nightclub  ✓" android:textColor="#FF1B1720" android:textSize="15sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="● Alfred is here now   •   Available 04:45" android:textColor="#FF3D6C50" android:textSize="13sp"/>
      <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="8dp" android:orientation="horizontal"><TextView android:id="@+id/feed_lobby" style="@style/FeedInviteAction" android:text="Club Lobby"/><TextView android:id="@+id/feed_route" style="@style/FeedInviteAction" android:text="Route"/></LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
