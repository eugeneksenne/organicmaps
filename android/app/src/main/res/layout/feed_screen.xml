<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/feed_moment_background">

  <View
    android:layout_width="260dp"
    android:layout_height="260dp"
    android:layout_gravity="center"
    android:alpha="0.09"
    android:background="@drawable/camera_look_selected"/>

  <View
    android:id="@+id/feed_tap_prev"
    android:layout_width="72dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:contentDescription="@string/back"/>

  <View
    android:id="@+id/feed_tap_next"
    android:layout_width="72dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:layout_marginEnd="68dp"
    android:contentDescription="@string/next_button"/>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView android:id="@+id/feed_for_you" style="@style/FeedTab.Active" android:text="For You"/>
      <TextView android:id="@+id/feed_following" style="@style/FeedTab" android:text="Following"/>
      <TextView android:id="@+id/feed_nearby" style="@style/FeedTab" android:text="Nearby"/>
      <TextView android:id="@+id/feed_live" style="@style/FeedTab" android:text="Live ●"/>
      <TextView
        android:id="@+id/feed_search"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="⌕"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:contentDescription="@string/search"/>
    </LinearLayout>
    <TextView
      android:id="@+id/feed_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingTop="6dp"
      android:textColor="#CCFFFFFF"
      android:textSize="12sp"
      android:visibility="gone"/>
  </LinearLayout>

  <TextView
    android:id="@+id/feed_empty"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:text="@string/feed_empty"
    android:textColor="#99FFFFFF"
    android:textSize="15sp"
    android:visibility="gone"/>

  <LinearLayout
    android:layout_width="68dp"
    android:layout_height="wrap_content"
    android:layout_gravity="end|center_vertical"
    android:gravity="center"
    android:orientation="vertical">
    <TextView android:id="@+id/feed_follow" style="@style/FeedAction" android:text="+\nFollow"/>
    <TextView android:id="@+id/feed_like" style="@style/FeedAction" android:text="♡\n0"/>
    <TextView android:id="@+id/feed_ripple" style="@style/FeedAction" android:text="≋\nRipple"/>
    <TextView android:id="@+id/feed_comment" style="@style/FeedAction" android:text="◌\n0"/>
    <TextView android:id="@+id/feed_save" style="@style/FeedAction" android:text="⌑\nSave"/>
    <TextView android:id="@+id/feed_share" style="@style/FeedAction" android:text="↗\nShare"/>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="92dp"
    android:paddingBottom="18dp">
    <LinearLayout
      android:id="@+id/feed_profile"
      android:layout_width="match_parent"
      android:layout_height="42dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/feed_avatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:background="@drawable/camera_capture_ring"
        android:textColor="@android:color/white"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/feed_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/feed_context"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"/>
    </LinearLayout>
    <TextView
      android:id="@+id/feed_caption"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:maxLines="3"
      android:textColor="@android:color/white"
      android:textSize="15sp"/>
    <TextView
      android:id="@+id/feed_intelligence"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="#E6FFFFFF"
      android:textSize="13sp"
      android:visibility="gone"/>
    <LinearLayout
      android:id="@+id/feed_invitation"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:background="@drawable/feed_invitation_background"
      android:orientation="vertical"
      android:padding="10dp"
      android:visibility="gone">
      <TextView
        android:id="@+id/feed_invitation_venue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF1B1720"
        android:textSize="15sp"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/feed_invitation_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FF3D6C50"
        android:textSize="13sp"/>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/feed_lobby" style="@style/FeedInviteAction" android:text="Club Lobby"/>
        <TextView android:id="@+id/feed_route" style="@style/FeedInviteAction" android:text="Route"/>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
