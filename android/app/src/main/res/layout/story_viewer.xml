<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/story_viewer_background">

  <TextView
    android:id="@+id/story_caption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:padding="28dp"
    android:textColor="@android:color/white"
    android:textSize="26sp"
    android:textStyle="bold"/>

  <View
    android:id="@+id/story_tap_left"
    android:layout_width="120dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"/>

  <View
    android:id="@+id/story_tap_right"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="120dp"/>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
      android:id="@+id/story_progress_row"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:orientation="horizontal"/>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="58dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/story_viewer_close"
        android:layout_width="38dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="×"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:contentDescription="@string/cancel"/>
      <TextView
        android:id="@+id/story_viewer_avatar"
        style="@style/ChatAvatar"
        android:text="A"/>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
          android:id="@+id/story_viewer_name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:textColor="@android:color/white"
          android:textSize="16sp"
          android:textStyle="bold"/>
        <TextView
          android:id="@+id/story_viewer_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="#CCFFFFFF"
          android:textSize="12sp"/>
      </LinearLayout>
      <TextView
        android:id="@+id/story_more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="⋮"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:contentDescription="@string/chats_more"/>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_gravity="bottom"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <EditText
      android:id="@+id/story_reply"
      android:layout_width="0dp"
      android:layout_height="42dp"
      android:layout_weight="1"
      android:background="@drawable/camera_venue_pill"
      android:hint="@string/story_reply_hint"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:textColor="@android:color/white"
      android:textColorHint="#CCFFFFFF"
      android:importantForAutofill="no"/>
    <TextView
      android:id="@+id/story_react"
      android:layout_width="48dp"
      android:layout_height="42dp"
      android:gravity="center"
      android:text="♡"
      android:textColor="@android:color/white"
      android:textSize="26sp"
      android:contentDescription="@string/chats_react"/>
  </LinearLayout>
</FrameLayout>
