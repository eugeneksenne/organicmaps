<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_cards"
  android:orientation="vertical"
  android:paddingTop="18dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="16dp">
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/main_tab_chats"
      android:textColor="@color/text_dark"
      android:textSize="30sp"
      android:textStyle="bold"/>
    <TextView
      android:id="@+id/chats_account"
      android:layout_width="42dp"
      android:layout_height="42dp"
      android:gravity="center"
      android:text="☺"
      android:textColor="@color/text_dark"
      android:textSize="22sp"
      android:contentDescription="@string/chats_account"/>
    <TextView
      android:id="@+id/chats_search"
      android:layout_width="42dp"
      android:layout_height="42dp"
      android:gravity="center"
      android:text="⌕"
      android:textColor="@color/text_dark"
      android:textSize="28sp"
      android:contentDescription="@string/search"/>
    <TextView
      android:id="@+id/chats_new"
      android:layout_width="42dp"
      android:layout_height="42dp"
      android:gravity="center"
      android:text="＋"
      android:textColor="@color/text_dark"
      android:textSize="26sp"
      android:contentDescription="@string/chats_new"/>
  </LinearLayout>

  <TextView
    android:id="@+id/chats_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="6dp"
    android:textColor="@color/text_dark_subtitle"
    android:textSize="12sp"
    android:visibility="gone"/>

  <LinearLayout
    android:id="@+id/chats_auth"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp"
    android:visibility="gone">
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/chats_sign_in_title"
      android:textColor="@color/text_dark"
      android:textSize="16sp"
      android:textStyle="bold"/>
    <EditText
      android:id="@+id/chats_auth_email"
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:layout_marginTop="8dp"
      android:background="@drawable/camera_look"
      android:hint="@string/email"
      android:inputType="textEmailAddress"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:textColor="@color/text_dark"
      android:textColorHint="@color/text_dark_hint"
      android:importantForAutofill="yes"
      android:autofillHints="emailAddress"/>
    <EditText
      android:id="@+id/chats_auth_password"
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:layout_marginTop="8dp"
      android:background="@drawable/camera_look"
      android:hint="@string/password"
      android:inputType="textPassword"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:textColor="@color/text_dark"
      android:textColorHint="@color/text_dark_hint"
      android:importantForAutofill="yes"
      android:autofillHints="password"/>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/chats_auth_signin"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@drawable/chat_category_active"
        android:gravity="center"
        android:text="@string/login"
        android:textColor="@android:color/white"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/chats_auth_signup"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/camera_look"
        android:gravity="center"
        android:text="@string/chats_create_account"
        android:textColor="@color/text_dark"
        android:textStyle="bold"/>
    </LinearLayout>
  </LinearLayout>

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="20dp"
        android:text="@string/chats_stories_label"
        android:textColor="@color/text_dark_hint"
        android:textSize="11sp"
        android:textStyle="bold"/>
      <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:paddingStart="16dp"
        android:scrollbars="none">
        <LinearLayout
          android:id="@+id/chats_stories"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:gravity="center_vertical"
          android:orientation="horizontal"/>
      </HorizontalScrollView>
      <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="16dp"
        android:scrollbars="none">
        <LinearLayout
          android:id="@+id/chats_categories"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:gravity="center_vertical"
          android:orientation="horizontal">
          <TextView style="@style/ChatCategory.Active" android:text="@string/main_tab_chats"/>
          <TextView style="@style/ChatCategory" android:text="@string/chats_calls"/>
          <TextView style="@style/ChatCategory" android:text="@string/chats_groups"/>
        </LinearLayout>
      </HorizontalScrollView>
      <TextView
        android:id="@+id/chats_pinned_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="20dp"
        android:text="@string/chats_pinned"
        android:textColor="@color/text_dark_hint"
        android:textSize="11sp"
        android:textStyle="bold"/>
      <LinearLayout
        android:id="@+id/chats_pinned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
      <TextView
        android:id="@+id/chats_recent_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:text="@string/chats_recent"
        android:textColor="@color/text_dark_hint"
        android:textSize="11sp"
        android:textStyle="bold"/>
      <LinearLayout
        android:id="@+id/chats_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
      <TextView
        android:id="@+id/chats_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:gravity="center"
        android:text="@string/chats_empty"
        android:textColor="@color/text_dark_subtitle"
        android:textSize="15sp"
        android:visibility="gone"/>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
