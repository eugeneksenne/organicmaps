<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_window">
  <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="28dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="278dp" android:background="@drawable/discover_hero_background" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Johannesburg" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18°  Clear" android:textColor="#E6FFFFFF" android:textSize="13sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:text="The city is warming up." android:textColor="@android:color/white" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Your circle is heading out. Find your moment." android:textColor="#E6FFFFFF" android:textSize="15sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="horizontal">
          <TextView style="@style/DiscoverHeroMetric" android:text="72% ENERGY"/><TextView style="@style/DiscoverHeroMetric" android:text="18 LIVE"/><TextView style="@style/DiscoverHeroMetric" android:text="6 DROPS"/>
        </LinearLayout>
        <TextView android:id="@+id/discover_hero_action" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginTop="16dp" android:background="@drawable/camera_look_selected" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Explore tonight  →" android:textColor="#FF211729" android:textSize="13sp" android:textStyle="bold" />
      </LinearLayout>
      <LinearLayout android:id="@+id/discover_sections" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
  </ScrollView>
</FrameLayout>
