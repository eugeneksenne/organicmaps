<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_cards"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="8dp">
    <TextView
      android:id="@+id/conversation_back"
      android:layout_width="34dp"
      android:layout_height="58dp"
      android:gravity="center"
      android:text="‹"
      android:textColor="@color/text_dark"
      android:textSize="38sp"
      android:contentDescription="@string/back"/>
    <TextView
      android:id="@+id/conversation_avatar"
      style="@style/ChatAvatar"
      android:text="•"/>
    <LinearLayout
      android:id="@+id/conversation_header"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:id="@+id/conversation_name"
        style="@style/ChatName"/>
      <TextView
        android:id="@+id/conversation_presence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/bg_primary"
        android:textSize="12sp"/>
    </LinearLayout>
    <TextView
      android:id="@+id/conversation_voice"
      style="@style/ConversationAction"
      android:text="☎"
      android:contentDescription="@string/chats_voice_call"/>
    <TextView
      android:id="@+id/conversation_video"
      style="@style/ConversationAction"
      android:text="▣"
      android:contentDescription="@string/chats_video_call"/>
    <TextView
      android:id="@+id/conversation_menu"
      style="@style/ConversationAction"
      android:text="⋮"
      android:contentDescription="@string/chats_more"/>
  </LinearLayout>

  <EditText
    android:id="@+id/conversation_search"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/camera_look"
    android:hint="@string/chats_search_conversation"
    android:inputType="text"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:textColor="@color/text_dark"
    android:textColorHint="@color/text_dark_hint"
    android:visibility="gone"
    android:importantForAutofill="no"/>

  <TextView
    android:id="@+id/conversation_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="4dp"
    android:textColor="@color/text_dark_subtitle"
    android:textSize="12sp"
    android:visibility="gone"/>

  <TextView
    android:id="@+id/conversation_pinned"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:background="#FFF3E9FF"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:textColor="#FF5D1FD0"
    android:textSize="13sp"
    android:visibility="gone"/>

  <ScrollView
    android:id="@+id/conversation_scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">
    <LinearLayout
      android:id="@+id/conversation_messages"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp"/>
  </ScrollView>

  <LinearLayout
    android:id="@+id/conversation_reply"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFF3E9FF"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:visibility="gone">
    <TextView
      android:id="@+id/conversation_reply_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textColor="#FF5D1FD0"
      android:textSize="12sp"/>
    <TextView
      android:id="@+id/conversation_cancel_reply"
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:gravity="center"
      android:text="×"
      android:textColor="#FF5D1FD0"
      android:textSize="22sp"
      android:contentDescription="@string/cancel"/>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <TextView
      android:id="@+id/conversation_attach"
      android:layout_width="38dp"
      android:layout_height="44dp"
      android:gravity="center"
      android:text="＋"
      android:textColor="@color/text_dark"
      android:textSize="25sp"
      android:contentDescription="@string/chats_attach"/>
    <EditText
      android:id="@+id/conversation_input"
      android:layout_width="0dp"
      android:layout_height="44dp"
      android:layout_weight="1"
      android:background="@drawable/camera_look"
      android:hint="@string/chats_message_hint"
      android:inputType="textCapSentences|textMultiLine"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:textColor="@color/text_dark"
      android:textColorHint="@color/text_dark_hint"/>
    <TextView
      android:id="@+id/conversation_send"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:gravity="center"
      android:text="🎤"
      android:textColor="@color/bg_primary"
      android:textSize="22sp"
      android:contentDescription="@string/chats_send"/>
  </LinearLayout>
</LinearLayout>
