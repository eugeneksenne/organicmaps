<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_cards" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="16dp"><TextView android:id="@+id/conversation_back" android:layout_width="38dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textColor="@color/text_dark" android:textSize="38sp"/><TextView style="@style/ChatAvatar" android:text="A"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/conversation_name" style="@style/ChatName"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active now" android:textColor="@color/text_dark_subtitle" android:textSize="12sp"/></LinearLayout><TextView android:layout_width="36dp" android:layout_height="48dp" android:gravity="center" android:text="☎" android:textColor="@color/text_dark" android:textSize="21sp"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/chat_avatar" android:padding="12dp" android:text="I’m at Cocoon — pull through 🔥" android:textColor="@color/text_dark" android:textSize="15sp"/><TextView android:id="@+id/conversation_sent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="right" android:layout_marginTop="12dp" android:background="@drawable/chat_category_active" android:padding="12dp" android:text="I’ll be there soon" android:textColor="@android:color/white" android:textSize="15sp"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp"><TextView android:layout_width="34dp" android:layout_height="44dp" android:gravity="center" android:text="＋" android:textColor="@color/text_dark" android:textSize="23sp"/><EditText android:id="@+id/conversation_input" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/camera_look" android:hint="Message" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/text_dark" android:textColorHint="@color/text_dark_hint"/><TextView android:id="@+id/conversation_send" android:layout_width="48dp" android:layout_height="44dp" android:gravity="center" android:text="↑" android:textColor="@color/bg_primary" android:textSize="26sp"/></LinearLayout>
</LinearLayout>
