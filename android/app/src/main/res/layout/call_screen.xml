<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/call_screen_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp"><TextView android:id="@+id/call_screen_quality" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Excellent connection" android:textColor="#CCFFFFFF" android:textSize="13sp"/><TextView style="@style/CallScreenAvatar" android:id="@+id/call_screen_avatar" android:text="A"/><TextView android:id="@+id/call_screen_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="@android:color/white" android:textSize="28sp" android:textStyle="bold"/><TextView android:id="@+id/call_screen_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Calling…" android:textColor="#CCFFFFFF" android:textSize="16sp"/><TextView android:id="@+id/call_screen_participants" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#CCFFFFFF" android:textSize="13sp" android:visibility="gone"/></LinearLayout>
  <TextView android:id="@+id/call_screen_local_preview" android:layout_width="96dp" android:layout_height="128dp" android:layout_gravity="right|top" android:layout_marginTop="52dp" android:layout_marginEnd="16dp" android:background="@drawable/fomo_map_card" android:gravity="center" android:text="You" android:textColor="@android:color/white" android:textSize="13sp" android:visibility="gone"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:gravity="center" android:orientation="vertical" android:paddingBottom="36dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="72dp" android:gravity="center" android:orientation="horizontal"><TextView android:id="@+id/call_screen_mute" style="@style/CallControl" android:text="♩\nMute"/><TextView android:id="@+id/call_screen_speaker" style="@style/CallControl" android:text="◖\nSpeaker"/><TextView android:id="@+id/call_screen_camera" style="@style/CallControl" android:text="▣\nCamera"/><TextView android:id="@+id/call_screen_participant_button" style="@style/CallControl" android:text="♧\nPeople" android:visibility="gone"/></LinearLayout><LinearLayout android:layout_width="wrap_content" android:layout_height="76dp" android:gravity="center" android:orientation="horizontal"><TextView android:id="@+id/call_screen_decline" style="@style/CallAnswer" android:background="@drawable/call_end" android:text="×"/><TextView android:id="@+id/call_screen_answer" style="@style/CallAnswer" android:layout_marginStart="42dp" android:background="@drawable/chat_category_active" android:text="☎" android:visibility="gone"/></LinearLayout></LinearLayout>
</FrameLayout>
