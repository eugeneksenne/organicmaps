<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/call_screen_background">

  <FrameLayout
    android:id="@+id/call_remote_video"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"/>

  <LinearLayout
    android:id="@+id/call_center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
      android:id="@+id/call_screen_quality"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/call_quality_good"
      android:textColor="#CCFFFFFF"
      android:textSize="13sp"/>
    <TextView
      android:id="@+id/call_screen_avatar"
      style="@style/CallScreenAvatar"
      android:text="A"/>
    <TextView
      android:id="@+id/call_screen_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:textColor="@android:color/white"
      android:textSize="28sp"
      android:textStyle="bold"/>
    <TextView
      android:id="@+id/call_screen_type"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="#CCFFFFFF"
      android:textSize="14sp"/>
    <TextView
      android:id="@+id/call_screen_status"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/call_calling"
      android:textColor="#CCFFFFFF"
      android:textSize="16sp"/>
    <TextView
      android:id="@+id/call_screen_participants"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="#CCFFFFFF"
      android:textSize="13sp"
      android:visibility="gone"/>
    <TextView
      android:id="@+id/call_nightguard"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:background="#33000000"
      android:gravity="center"
      android:padding="10dp"
      android:text="@string/call_nightguard_banner"
      android:textColor="#FF8EF6B7"
      android:textSize="13sp"
      android:visibility="gone"/>
  </LinearLayout>

  <TextView
    android:id="@+id/call_screen_local_preview"
    android:layout_width="96dp"
    android:layout_height="128dp"
    android:layout_gravity="end|top"
    android:layout_marginTop="52dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/fomo_map_card"
    android:gravity="center"
    android:text="@string/call_you"
    android:textColor="@android:color/white"
    android:textSize="13sp"
    android:visibility="gone"
    android:contentDescription="@string/call_local_preview"/>

  <LinearLayout
    android:id="@+id/call_incoming_extras"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginBottom="170dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:visibility="gone">
    <TextView
      android:id="@+id/call_reply_message"
      android:layout_width="wrap_content"
      android:layout_height="40dp"
      android:layout_marginEnd="12dp"
      android:background="@drawable/camera_venue_pill"
      android:gravity="center"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:text="@string/call_reply_message"
      android:textColor="@android:color/white"/>
    <TextView
      android:id="@+id/call_silence"
      android:layout_width="wrap_content"
      android:layout_height="40dp"
      android:background="@drawable/camera_venue_pill"
      android:gravity="center"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:text="@string/call_silence"
      android:textColor="@android:color/white"/>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingBottom="36dp">
    <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:scrollbars="none">
      <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView android:id="@+id/call_screen_mute" style="@style/CallControl" android:text="@string/call_mute" android:contentDescription="@string/call_mute"/>
        <TextView android:id="@+id/call_screen_speaker" style="@style/CallControl" android:text="@string/call_speaker" android:contentDescription="@string/call_speaker"/>
        <TextView android:id="@+id/call_bluetooth" style="@style/CallControl" android:text="@string/call_bluetooth" android:contentDescription="@string/call_bluetooth"/>
        <TextView android:id="@+id/call_screen_camera" style="@style/CallControl" android:text="@string/call_camera" android:contentDescription="@string/call_camera"/>
        <TextView android:id="@+id/call_flip" style="@style/CallControl" android:text="@string/call_flip" android:contentDescription="@string/call_flip"/>
        <TextView android:id="@+id/call_screen_participant_button" style="@style/CallControl" android:text="@string/call_people" android:contentDescription="@string/call_people"/>
        <TextView android:id="@+id/call_chat" style="@style/CallControl" android:text="@string/call_chat" android:contentDescription="@string/call_chat"/>
      </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="76dp"
      android:gravity="center"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/call_screen_decline"
        style="@style/CallAnswer"
        android:background="@drawable/call_end"
        android:text="×"
        android:contentDescription="@string/call_end"/>
      <TextView
        android:id="@+id/call_screen_answer"
        style="@style/CallAnswer"
        android:layout_marginStart="42dp"
        android:background="@drawable/chat_category_active"
        android:text="☎"
        android:visibility="gone"
        android:contentDescription="@string/call_answer"/>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/call_participants_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#F21A1520"
    android:orientation="vertical"
    android:padding="18dp"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical">
      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/call_participants"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/call_sheet_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="×"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:contentDescription="@string/cancel"/>
    </LinearLayout>
    <LinearLayout
      android:id="@+id/call_participants_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingTop="8dp"/>
  </LinearLayout>
</FrameLayout>
