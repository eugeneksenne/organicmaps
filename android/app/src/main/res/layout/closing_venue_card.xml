<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="176dp"
  android:layout_marginBottom="14dp" android:background="@drawable/feed_invitation_background"
  android:orientation="horizontal" android:padding="12dp">

  <!-- Hero side -->
  <FrameLayout android:id="@+id/venue_hero" android:layout_width="100dp" android:layout_height="match_parent"
    android:background="@drawable/feed_moment_background">
    <TextView android:id="@+id/venue_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_gravity="top|start" android:layout_margin="8dp"
      android:background="#CC1B1724" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp"
      android:text="🔥 Popular" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold"/>
    <TextView android:id="@+id/venue_crowd_meter" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_gravity="bottom|start" android:layout_margin="8dp"
      android:text="Packed" android:textColor="#CCFFFFFF" android:textSize="10sp"/>
  </FrameLayout>

  <!-- Center info -->
  <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:layout_marginStart="12dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:id="@+id/venue_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:ellipsize="end" android:maxLines="1" android:textColor="#FF1B1720"
        android:textSize="17sp" android:textStyle="bold"/>
      <TextView android:id="@+id/venue_verified" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:text="✓" android:textColor="#FF3D6C50" android:textSize="14sp"/>
    </LinearLayout>
    <TextView android:id="@+id/venue_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="2dp" android:text="Bar • 0.8 km  •  ★ 4.6"
      android:textColor="#801B1720" android:textSize="12sp"/>
    <TextView android:id="@+id/venue_address" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
      android:text="Sandton, Johannesburg" android:textColor="#661B1720" android:textSize="11sp"/>
    <TextView android:id="@+id/venue_smart_message" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:maxLines="2"
      android:text="Kitchen closes in 17 min" android:textColor="#FF1B1720" android:textSize="13sp" android:textStyle="bold"/>
    <TextView android:id="@+id/venue_eta" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="🚗 8 min away  •  You'll arrive before closing."
      android:textColor="#FF3D6C50" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="6dp" android:orientation="horizontal">
      <TextView android:id="@+id/venue_social" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:maxLines="1" android:text="12 heading here" android:textColor="#801B1720" android:textSize="11sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:orientation="horizontal">
      <TextView android:id="@+id/venue_cta_directions" android:layout_width="wrap_content" android:layout_height="34dp"
        android:background="@drawable/feed_glass_pill" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:text="Directions" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold"/>
      <TextView android:id="@+id/venue_cta_save" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginStart="6dp" android:background="@drawable/camera_look" android:gravity="center"
        android:text="⌑" android:textColor="#FF1B1720" android:textSize="14sp"/>
      <TextView android:id="@+id/venue_cta_share" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginStart="6dp" android:background="@drawable/camera_look" android:gravity="center"
        android:text="↗" android:textColor="#FF1B1720" android:textSize="14sp"/>
      <TextView android:id="@+id/venue_cta_website" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginStart="6dp" android:background="@drawable/camera_look" android:gravity="center"
        android:text="◉" android:textColor="#FF1B1720" android:textSize="14sp"/>
    </LinearLayout>
  </LinearLayout>

  <!-- Countdown ring -->
  <FrameLayout android:id="@+id/venue_countdown_ring" android:layout_width="72dp" android:layout_height="72dp"
    android:layout_gravity="center_vertical" android:layout_marginStart="10dp"
    android:background="@drawable/camera_capture_ring" android:gravity="center">
    <TextView android:id="@+id/venue_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:gravity="center" android:text="18\nMIN" android:textColor="@android:color/white" android:textSize="13sp" android:textStyle="bold"/>
    <ProgressBar android:id="@+id/venue_countdown_progress" style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent" android:layout_height="match_parent"
      android:indeterminate="false" android:max="60" android:progress="42"
      android:progressDrawable="@drawable/closing_countdown_progress"
      android:rotation="-90" android:visibility="invisible"/>
  </FrameLayout>
</LinearLayout>
