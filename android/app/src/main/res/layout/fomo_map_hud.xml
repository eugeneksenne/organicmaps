<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/fomo_map_hud" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="false" android:focusable="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
      <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/chat_avatar" android:gravity="center" android:text="F" android:textColor="@color/text_dark" android:textSize="18sp" android:textStyle="bold"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOMO Score" android:textColor="@color/text_dark_subtitle" android:textSize="12sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♨ 92%" android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold"/></LinearLayout>
      <TextView android:id="@+id/fomo_map_search" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/fomo_map_chip" android:gravity="center" android:text="⌕" android:textColor="@color/text_dark" android:textSize="30sp" android:contentDescription="@string/search"/><TextView android:id="@+id/fomo_map_alerts" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="8dp" android:background="@drawable/fomo_map_chip" android:gravity="center" android:text="♧" android:textColor="@color/text_dark" android:textSize="26sp" android:contentDescription="Alerts"/>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="52dp" android:paddingStart="12dp" android:paddingTop="8dp" android:scrollbars="none"><LinearLayout android:id="@+id/fomo_map_categories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><TextView style="@style/FomoMapChip" android:text="◉  Live"/><TextView style="@style/FomoMapChip.Selected" android:text="☾  Nightlife"/><TextView style="@style/FomoMapChip" android:text="▰  Events"/><TextView style="@style/FomoMapChip" android:text="✦  Prep"/><TextView style="@style/FomoMapChip" android:text="♨  Food"/><TextView style="@style/FomoMapChip" android:text="◇  Luxury"/></LinearLayout></HorizontalScrollView>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="84dp" android:background="@drawable/fomo_map_card" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌁  NEAREST VENUE" android:textColor="#FF8B49E7" android:textSize="11sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="The Vault  ✓" android:textColor="@android:color/white" android:textSize="25sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Techno Club • 0.1 km away (2 min walk)" android:textColor="#CCFFFFFF" android:textSize="13sp"/></LinearLayout><LinearLayout android:layout_width="70dp" android:layout_height="62dp" android:background="@drawable/fomo_map_chip" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♨ 92%" android:textColor="@android:color/white" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOMO SCORE" android:textColor="#CCFFFFFF" android:textSize="8sp"/></LinearLayout></LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="12dp" android:background="@drawable/fomo_map_chip" android:gravity="center_vertical" android:paddingStart="12dp" android:text="●  Open Now     •     Closes 04:00 AM" android:textColor="#FF57E878" android:textSize="13sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:orientation="horizontal"><TextView android:id="@+id/fomo_map_lobby" style="@style/FomoMapButton" android:text="♧  Club Lobby"/><TextView android:id="@+id/fomo_map_route" style="@style/FomoMapButton.Primary" android:text="➤  Route"/></LinearLayout>
  </LinearLayout>
</FrameLayout>
