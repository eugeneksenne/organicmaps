<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/bg_cards"
  android:orientation="vertical"
  android:paddingTop="18dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="16dp">
    <TextView
      android:id="@+id/stories_back"
      android:layout_width="34dp"
      android:layout_height="44dp"
      android:gravity="center"
      android:text="‹"
      android:textColor="@color/text_dark"
      android:textSize="38sp"
      android:contentDescription="@string/back"/>
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/chats_stories_label"
      android:textColor="@color/text_dark"
      android:textSize="30sp"
      android:textStyle="bold"/>
    <TextView
      android:id="@+id/stories_camera"
      style="@style/ConversationAction"
      android:text="▣"
      android:contentDescription="@string/chats_attach_camera"/>
  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:paddingStart="20dp"
    android:text="@string/chats_my_story"
    android:textColor="@color/text_dark_hint"
    android:textSize="11sp"
    android:textStyle="bold"/>

  <LinearLayout
    android:id="@+id/story_add"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <TextView style="@style/StoryAvatar" android:text="F"/>
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView style="@style/ChatName" android:text="@string/chats_my_story"/>
      <TextView style="@style/ChatPreview" android:text="@string/chats_attach_camera"/>
    </LinearLayout>
  </LinearLayout>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:paddingStart="20dp"
    android:text="@string/chats_recent"
    android:textColor="@color/text_dark_hint"
    android:textSize="11sp"
    android:textStyle="bold"/>

  <ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <LinearLayout
        android:id="@+id/stories_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
      <TextView
        android:id="@+id/stories_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/story_empty"
        android:textColor="@color/text_dark_subtitle"
        android:textSize="15sp"
        android:visibility="gone"/>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
