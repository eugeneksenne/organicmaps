<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_cards" android:orientation="vertical" android:paddingTop="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="16dp"><TextView android:id="@+id/stories_back" android:layout_width="34dp" android:layout_height="44dp" android:gravity="center" android:text="‹" android:textColor="@color/text_dark" android:textSize="38sp"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Stories" android:textColor="@color/text_dark" android:textSize="30sp" android:textStyle="bold"/><TextView android:id="@+id/stories_camera" style="@style/ConversationAction" android:text="▣" android:contentDescription="Camera"/></LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:paddingStart="20dp" android:text="MY STORY" android:textColor="@color/text_dark_hint" android:textSize="11sp" android:textStyle="bold"/>
  <LinearLayout android:id="@+id/story_add" android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp"><FrameLayout android:layout_width="54dp" android:layout_height="54dp"><TextView style="@style/StoryAvatar" android:text="F"/><TextView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|right" android:background="@drawable/chat_category_active" android:gravity="center" android:text="+" android:textColor="@android:color/white" android:textSize="16sp"/></FrameLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/ChatName" android:text="Add to your story"/><TextView style="@style/ChatPreview" android:text="Share a photo or video for 24 hours"/></LinearLayout></LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingStart="20dp" android:text="RECENT UPDATES" android:textColor="@color/text_dark_hint" android:textSize="11sp" android:textStyle="bold"/>
  <LinearLayout android:id="@+id/story_alfred" style="@style/ChatRow"><TextView style="@style/StoryAvatar" android:text="A"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView style="@style/ChatName" android:text="Alfred M.  ✓"/><TextView style="@style/ChatPreview" android:text="2 minutes ago • Cocoon Nightclub"/></LinearLayout></LinearLayout>
  <LinearLayout android:id="@+id/story_nomsa" style="@style/ChatRow"><TextView style="@style/StoryAvatar" android:text="N"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView style="@style/ChatName" android:text="Nomsa"/><TextView style="@style/ChatPreview" android:text="18 minutes ago"/></LinearLayout></LinearLayout>
  <LinearLayout android:id="@+id/story_vault" style="@style/ChatRow"><TextView style="@style/StoryAvatar" android:text="V"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView style="@style/ChatName" android:text="The Vault  ✓"/><TextView style="@style/ChatPreview" android:text="Live now • Amapiano Fridays"/></LinearLayout></LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingStart="20dp" android:text="VIEWED" android:textColor="@color/text_dark_hint" android:textSize="11sp" android:textStyle="bold"/>
  <LinearLayout android:id="@+id/story_lerato" style="@style/ChatRow"><TextView style="@style/ChatAvatar" android:text="L"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"><TextView style="@style/ChatName" android:text="Lerato"/><TextView style="@style/ChatPreview" android:text="Yesterday"/></LinearLayout></LinearLayout>
</LinearLayout>
