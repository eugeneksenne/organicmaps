# Never commit .env. Use Supabase CLI secrets for deployed Edge Functions.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_PROJECT_REF=replace-with-remote-project-ref-for-manual-schema-push
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=fomo-local
MINIO_SECRET_KEY=replace-with-a-long-local-secret
WEBRTC_TURN_URL=turn:turn.example.com:3478
WEBRTC_TURN_USERNAME=replace-me
WEBRTC_TURN_CREDENTIAL=replace-me
