NODE_ENV=production
PORT=3001
# Comma-separated browser origins. Never use * for a production authenticated socket service.
ALLOWED_ORIGINS=https://app.example.com
SUPABASE_URL=https://your-project.supabase.co
# Server only. Do not expose this in Android, browser code, git, or logs.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Optional; enables multi-instance Socket.IO fanout.
REDIS_URL=redis://127.0.0.1:6379

# Feed worker polling cadence; ranking is server-side only.
FEED_RANK_INTERVAL_MS=30000
